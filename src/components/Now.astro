---
import Card from "./Card/index.astro";
import Pulse from "./Pulse.astro";
import { timeline } from "../data/timeline";

const latest = timeline[0];
---

<a href="/now" class="block h-full">
  <Card colSpan="md:col-span-1" rowSpan="md:row-span-2">
    <div class="flex justify-between w-full items-start mb-2">
      <div class="flex flex-col">
        <h2>Now</h2>
        <span class="text-xs text-gray-500">click to see full timeline</span>
      </div>
      <Pulse />
    </div>
    <p class="text-xs">{latest.title}</p>
    <p class="text-xs text-gray-500 mt-1">{latest.date}</p>
  </Card>
</a>
