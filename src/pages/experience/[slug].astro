---
import Layout from "../../layouts/Layout.astro";
import { workExperiences } from "../../data/workExperience";

const { slug } = Astro.params;
const exp = workExperiences.find((e) => e.slug === slug);

if (!exp) return Astro.redirect("/experience");
---

<script>
  import { animate, type AnimationSequence } from "motion";
  import { loaderAnimation } from "../../lib/constants";
  animate([loaderAnimation] as AnimationSequence);
</script>

<Layout
  description={exp.description}
  title={`${exp.company} — Mohammed Ateeq`}
>
  <main class="w-full min-h-screen max-w-3xl mx-auto px-6 py-10 text-neutral-100">
    <a
      class="inline-flex items-center gap-2 text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-10 border border-neutral-600 rounded-lg text-sm transition-colors"
      href="/experience"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Back to Experience
    </a>

    <div class="mb-8">
      <p class="text-primary-400 text-sm font-medium uppercase tracking-wider mb-2">
        {exp.period}
      </p>
      <h1 class="text-4xl font-bold">{exp.company}</h1>
      <p class="text-gray-400 mt-2">{exp.role}</p>
    </div>

    <section class="mb-8">
      <p class="text-gray-300 font-light leading-relaxed">{exp.description}</p>
    </section>

    <section class="mb-8">
      <h2 class="text-xl font-bold mb-4">Highlights</h2>
      <ul class="flex flex-col gap-3">
        {
          exp.highlights.map((item) => (
            <li class="flex items-start gap-3 text-sm text-gray-300 font-light">
              <span class="text-primary-400 mt-0.5 shrink-0">▹</span>
              {item}
            </li>
          ))
        }
      </ul>
    </section>

    <section>
      <h2 class="text-xl font-bold mb-4">Tech Stack</h2>
      <div class="flex flex-wrap gap-2">
        {
          exp.tech.map((tag) => (
            <span class="text-sm bg-white/10 px-3 py-1 rounded-full text-gray-300">
              {tag}
            </span>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
